[Unit]
Description=NetScope network monitoring service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=netscope
Group=netscope
WorkingDirectory=/opt/netscope
Environment=NETSCOPE_BIND=127.0.0.1
Environment=NETSCOPE_PORT=8080
EnvironmentFile=-/etc/netscope.env
# Safe local-only default. The installer writes the selected private LAN or localhost bind address.
ExecStart=/opt/netscope/venv/bin/gunicorn --workers 1 --bind ${NETSCOPE_BIND}:${NETSCOPE_PORT} --access-logfile - --error-logfile - app:app
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
