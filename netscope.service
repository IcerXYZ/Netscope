[Unit]
Description=NetScope monitoring dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=netscope
Group=netscope
WorkingDirectory=/opt/netscope
Environment=NETSCOPE_HOST=0.0.0.0
Environment=NETSCOPE_PORT=8080
ExecStart=/opt/netscope/venv/bin/gunicorn --workers 2 --bind 0.0.0.0:8080 app:app
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
