#!/usr/bin/env bash
set -Eeuo pipefail
case "${1:-}" in
  setup) shift; exec bash /usr/lib/netscope/install.sh "$@" ;;
  --version|-v) echo "NetScope 0.2.0" ;;
  --help|-h|"") echo "NetScope: run sudo netscope setup to configure and install the service." ;;
  *) echo "Unknown option" >&2; exit 2 ;;
esac

