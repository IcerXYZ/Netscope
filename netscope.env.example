# Example only. Keep real secrets in /etc/netscope.env, never in Git.
NETSCOPE_ROLE=server
NETSCOPE_PORT=8080
NETSCOPE_HOST=0.0.0.0
# Generate a private random token and use the same value on the server and all agents.
NETSCOPE_AGENT_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Agent-only setting:
# NETSCOPE_SERVER_URL=http://192.168.6.20:8080
# Optional Discord webhook:
# NETSCOPE_DISCORD_WEBHOOK=https://discord.com/api/webhooks/REPLACE_ME
