# Legacy NetScope environment example.
# Keep real settings in /etc/netscope.env with root-only permissions.
NETSCOPE_ROLE=server
# Local listening port for this server OR agent; change if already occupied.
NETSCOPE_PORT=8080
# Example alternative: NETSCOPE_PORT=10101
# Bind to a trusted private LAN IP or 127.0.0.1. Do not use 0.0.0.0 unless you understand the exposure.
NETSCOPE_HOST=127.0.0.1
NETSCOPE_BIND=127.0.0.1
NETSCOPE_AUTH_ENABLED=true
NETSCOPE_AUTH_USERNAME=admin
NETSCOPE_AUTH_PASSWORD_HASH=
NETSCOPE_SECRET_KEY=replace-with-a-long-random-secret
NETSCOPE_AGENT_TOKENS_FILE=/etc/netscope-agent-tokens.json

# Agent-only settings: configure a different unique token on each agent.
# NETSCOPE_ROLE=agent
# Central destination, independent of this agent local NETSCOPE_PORT.
# If the central dashboard uses 10101:
# NETSCOPE_SERVER_URL=http://192.168.6.20:10101
# NETSCOPE_AGENT_ID=debian-node-01
# NETSCOPE_AGENT_TOKEN=unique-token-created-on-central-server

# Optional Discord alerts:
# NETSCOPE_DISCORD_WEBHOOK=
