# NetScope Pro configuration example
# Copy values into /etc/netscope-pro.env on the central monitoring node.
# Never commit a real Discord webhook URL to Git.

# Optional Discord webhook (keep the real value private)
# NETSCOPE_DISCORD_WEBHOOK=https://discord.com/api/webhooks/REPLACE_ME

# Optional remote nodes for Cluster mode (JSON array)
# Each remote host must run NetScope Pro and be reachable from this node.
# NETSCOPE_NODES=[{"name":"pve-node-2","url":"http://192.168.6.32:8080"},{"name":"pve-node-3","url":"http://192.168.6.33:8080"}]
