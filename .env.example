# Generate private settings with configure.py. This template intentionally fails closed.
NETSCOPE_ROLE=single
NETSCOPE_BIND=127.0.0.1
NETSCOPE_PORT=8080
NETSCOPE_AUTH_ENABLED=true
NETSCOPE_AUTH_USERNAME=admin
NETSCOPE_AUTH_PASSWORD_HASH=
NETSCOPE_SECRET_KEY=
NETSCOPE_TRUSTED_HOSTS=
NETSCOPE_TLS_CERT=
NETSCOPE_TLS_KEY=
NETSCOPE_AGENT_TOKENS_FILE=/etc/netscope/agents.json
# Agents need HTTPS, an enrolled ID and a fresh token.
# NETSCOPE_SERVER_URL=https://netscope.home.arpa:8080
# NETSCOPE_AGENT_ID=node-01
# NETSCOPE_AGENT_TOKEN=
# NETSCOPE_CA_FILE=/etc/netscope/ca.crt

